# Copy this file to `.env` and fill in your real key.
# Get one at https://rapidapi.com/api-sports/api/api-football
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle by Expo at build time —
# fine for a personal/dev project, but for a shipped app proxy requests
# through your own backend instead of shipping the key in the client.
EXPO_PUBLIC_RAPIDAPI_KEY=

# Optional — points the app at the backend in /server for real private
# leagues. Leave unset to keep the League tab showing sample data.
# Example: EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
EXPO_PUBLIC_BACKEND_URL=
