# Same key as the app's EXPO_PUBLIC_RAPIDAPI_KEY, but kept server-side only.
RAPIDAPI_KEY=

PORT=4000

# Where private-league data is persisted (a single JSON file — see
# src/store.ts). Fine for development; swap for a real database before
# running this anywhere users depend on it.
DATA_FILE=./data.json

# Gameweek lock: minutes before first fixture kick-off (API-Football has no official fantasy deadline field).
GAMEWEEK_DEADLINE_OFFSET_MINUTES=90
